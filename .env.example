# API keys must be supplied by each user through the app sidebar.
# The application never uses API keys from .env or the server environment.
# Do not add keys here.

# Optional non-secret Azure defaults for command-line LLMProvider callers
# that pass api_key explicitly. The web app uses the user's sidebar settings.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_VERSION=2024-10-21
